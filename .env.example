# ============================================================================
# AWS FinOps & Cost Intelligence Platform (FOCUS 1.0 Lakehouse)
# Copy this file to .env (`cp .env.example .env`) or run `python scripts/export_env.py`
# after deploying the CDK stacks to auto-populate from CloudFormation Outputs.
# ============================================================================

# --- Execution Mode ---
# Set DEMO_MODE=true for 100% local offline execution via DuckDB (no AWS required).
# Set DEMO_MODE=false to query live Amazon Athena, DynamoDB, and Amazon Bedrock.
DEMO_MODE=true

# --- AWS Environment (populated dynamically via CDK or your AWS CLI profile) ---
AWS_REGION=us-east-1
AWS_PROFILE=default

# --- FinOps Data Lake Stack Outputs ---
FINOPS_RAW_CUR_BUCKET=
FINOPS_FOCUS_CURATED_BUCKET=
FINOPS_ATHENA_RESULTS_BUCKET=
FINOPS_GLUE_RAW_DB=finops_raw
FINOPS_GLUE_CURATED_DB=finops_focus_curated
FINOPS_ATHENA_WORKGROUP=finops_cost_intelligence_wg
FINOPS_KMS_KEY_ARN=

# --- Transformation & Anomaly Detection Stack Outputs ---
FINOPS_GLUE_JOB_NAME=cur-to-focus-normalization-job
FINOPS_ANOMALIES_TABLE=FinOpsAnomaliesTable
FINOPS_STEP_FUNCTION_ARN=
FINOPS_ANOMALY_ZSCORE_THRESHOLD=2.2
FINOPS_ANOMALY_PCT_SPIKE_THRESHOLD=30.0
FINOPS_ANOMALY_MIN_DOLLAR_DELTA=25.0

# --- Advisor & Alerting Stack Outputs ---
FINOPS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
FINOPS_SNS_TOPIC_ARN=
FINOPS_ALERT_EMAIL=

# --- Local Simulator & DuckDB Settings ---
LOCAL_DATA_DIR=data
LOCAL_DUCKDB_PATH=data/finops_lakehouse.duckdb
REQUIRED_COST_TAGS=CostCenter,Environment,Owner,Project
